# Build context is the monorepo root — keep it small and keep local artefacts
# from leaking into the image.

**/node_modules
**/dist
**/.wrangler
**/*.tsbuildinfo

.git
.gitignore
.gitattributes

# Never bake real secrets into an image layer.
**/.env
**/.env.local
**/.env.*.local
**/.dev.vars

# The front-end apps are not needed to build or run the API — but their
# manifests are, because npm resolves the whole workspace graph from the root
# lockfile and `npm ci` fails if a workspace named there is missing.
century-nit-web/
!century-nit-web/package.json
century-nit-ops/
!century-nit-ops/package.json

**/*.md
**/*.log
docker-compose.yml
