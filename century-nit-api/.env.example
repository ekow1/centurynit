# Copy to .env for local development. `dotenv/config` loads it at startup.
# For production, set these in Dokploy (or your deployment platform).
#
# Fields marked REQUIRED-IN-PROD have development defaults but no production
# defaults — the API refuses to start without them when NODE_ENV=production.

# ── Runtime ──
NODE_ENV=development
PORT=3000

# ── Database ──
# Local docker-compose default:
DATABASE_URL=postgres://century:century@localhost:5433/century_nit
# Supabase session pooler (port 5432) — safe for transactions.
# NEVER use port 6543 (transaction pooler) — the app refuses it at startup.
# Production:
#   DATABASE_URL=postgresql://postgres.bkajqyhkpxhapvgqxzwp:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# For migrations only (direct connection, not the pooler):
#   DATABASE_URL_MIGRATIONS=postgresql://postgres:[YOUR-PASSWORD]@db.bkajqyhkpxhapvgqxzwp.supabase.co:5432/postgres

# ── Redis (queue + sessions) ──
# Local docker-compose default:
REDIS_URL=redis://localhost:6380
# Production (e.g., Upstash):
#   REDIS_URL=redis://[YOUR-REDIS-HOST]:6379

# ── Better Auth ──
# REQUIRED-IN-PROD — min 32 chars. Generate with:
#   openssl rand -base64 48
# A value starting with "change-me" or "dev-only" is rejected in production.
BETTER_AUTH_SECRET=change-me-in-production-at-least-32-characters
# Public URL where this API is reachable.
BETTER_AUTH_URL=http://localhost:3000
# Public URL of the web frontend (for CORS, redirects, trusted origins).
FRONTEND_URL=http://localhost:5173
# Operations Center URL — separate Cloudflare Worker ("console").
CONSOLE_URL=http://localhost:5174

# ── Encryption key ──
# Encrypts OAuth tokens at rest. REQUIRED-IN-PROD, min 32 chars.
#   openssl rand -base64 48
ENCRYPTION_KEY=dev-only-insecure-encryption-key-not-for-production

# ── Supabase Storage (document uploads) ──
# Optional: without it, document endpoints refuse rather than accepting a file
# they cannot store.
SUPABASE_URL=https://bkajqyhkpxhapvgqxzwp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=applicant-documents

# ── Email (Resend) ──
# Optional — email delivery. Without a key, sends are logged and skipped.
RESEND_API_KEY=
RESEND_FROM=noreply@centurynit.com

# ── Google OAuth (sign-in + Calendar/Meet) ──
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (production):
#   https://century-nit-web.softclicksolutionsgh.workers.dev/api/auth/callback/google
# The provider is only registered when both CLIENT_ID and CLIENT_SECRET are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorised redirect URI in the Google Cloud console.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
# Optional — Google Calendar webhook for real-time sync:
GOOGLE_WEBHOOK_URL=
GOOGLE_WEBHOOK_TOKEN=

# ── Bootstrap (one-time super-admin setup) ──
# Enables POST /api/staff/bootstrap, which creates the first super administrator.
# One-time: the endpoint refuses as soon as any staff member exists. Remove this
# from the environment once setup is done.
#   openssl rand -hex 16
BOOTSTRAP_TOKEN=

# ── Optional defaults ──
# Minutes of protected gap either side of a booking. 0 disables buffers.
BOOKING_BUFFER_MINUTES=0
# Default IANA zone for branches and working hours.
DEFAULT_TIMEZONE=Africa/Accra

# SMS is pluggable and unconfigured. Without a provider, phone sign-in refuses
# rather than pretending to send a code. In development codes print to the
# console instead, so the flow is completable locally.
