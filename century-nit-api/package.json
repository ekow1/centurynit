{
	"name": "century-nit-api",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Century NIT backend API — Hono, Drizzle, Better Auth, BullMQ",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"worker:email": "npm run worker",
		"lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"seed:staff": "tsx src/scripts/seed-staff.ts",
		"worker": "tsx src/worker/main.ts",
		"worker:start": "node dist/worker/main.js"
	},
	"dependencies": {
		"@hono/node-server": "^1.13.0",
		"@hono/zod-openapi": "^0.18.0",
		"@scalar/hono-api-reference": "^0.11.14",
		"@supabase/supabase-js": "^2.112.3",
		"better-auth": "^1.0.0",
		"bullmq": "^5.0.0",
		"century-nit-core": "*",
		"century-nit-shared": "*",
		"dotenv": "^16.4.0",
		"drizzle-orm": "^0.45.2",
		"googleapis": "^174.0.1",
		"hono": "^4.11.0",
		"ioredis": "^5.4.0",
		"pg": "^8.13.0",
		"resend": "^3.2.0",
		"zod": "^3.23.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/pg": "^8.11.0",
		"drizzle-kit": "^0.30.5",
		"tsx": "^4.19.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.10"
	}
}
