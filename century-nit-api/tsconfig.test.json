{
	// Typechecks the test files, which the build config deliberately excludes so
	// they never reach dist. `npm run lint` runs both.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		// No emit, so rootDir does not need to bound these files.
		"rootDir": ".",
		"types": ["node"]
	},
	"include": ["src/**/*", "vitest.config.ts"],
	"exclude": ["node_modules", "dist"]
}
