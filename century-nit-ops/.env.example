# Copy to .env for local development, or set in Cloudflare Workers dashboard.
#
# In development, Vite proxies /api to http://localhost:3000 (see vite.config.ts),
# so VITE_API_BASE_URL can be empty.
#
# In production, the console Worker has no /api proxy, so this must be the
# absolute API origin.
VITE_API_BASE_URL=http://localhost:3000
